# =============================================================================
# apps/web  environment variables (Next.js)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is git-ignored and must NEVER be committed.
#
# Only NEXT_PUBLIC_* vars are exposed to the browser. Never put the Supabase
# service_role key, the DB connection string, or any R2/Resend secret in this
# app — those live in apps/api only.
# =============================================================================

# --- Supabase (public / browser-safe) ---
# The web app reaches Postgres only via the Supabase REST/JS client (anon key +
# RLS) or through the FastAPI backend. It has NO direct Postgres connection
# string by design — the pooled DATABASE_URL lives in apps/api/.env only.
#   NEXT_PUBLIC_SUPABASE_URL = https://ljgkhseuacyrqrhqqzon.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend API (FastAPI on Render) ---
# Base URL the web app calls, e.g. https://gym-os-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=
