# =============================================================================
# apps/api  environment variables (FastAPI)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values there.
# `.env` is git-ignored and must NEVER be committed.
# On Render, set these in the dashboard's Environment / Secrets UI instead.
# =============================================================================

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Supabase pooled connection, port 6543) ---
# Format is filled in during Phase 2. Real value goes in .env only.
DATABASE_URL=

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- CORS ---
# Comma-separated list of allowed browser origins (the Vercel URL).
# e.g. https://gym-os-web.vercel.app,http://localhost:3000
FRONTEND_ORIGIN=
