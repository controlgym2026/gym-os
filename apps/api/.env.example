# =============================================================================
# apps/api  environment variables (FastAPI)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values there.
# `.env` is git-ignored and must NEVER be committed.
# On Render, set these in the dashboard's Environment / Secrets UI instead.
# =============================================================================

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Supabase connection pooler) ---
# Runtime queries go through the transaction pooler on port 6543. Only the
# password is secret; put the real string in .env only.
#   postgresql://postgres.<project-ref>:<DB-PASSWORD>@<pooler-host>:6543/postgres
# For the linked project (ljgkhseuacyrqrhqqzon):
DATABASE_URL=postgresql://postgres.ljgkhseuacyrqrhqqzon:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Schema migrations need a non-pooled (session) connection — same host, port 5432.
# Leave unset in normal runtime; used by the migration tooling only.
DIRECT_URL=postgresql://postgres.ljgkhseuacyrqrhqqzon:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- CORS ---
# Comma-separated list of allowed browser origins (the Vercel URL).
# e.g. https://gym-os-web.vercel.app,http://localhost:3000
FRONTEND_ORIGIN=
